# 和风天气活动接入：真实 Key 仅写入本地 .env
WEATHER_PROVIDER=qweather
QWEATHER_ENABLED=true
QWEATHER_API_KEY=
QWEATHER_API_HOST=
QWEATHER_MAX_CALLS_PER_RUN=80
QWEATHER_CONNECT_TIMEOUT_SECONDS=5
QWEATHER_READ_TIMEOUT_SECONDS=20
QWEATHER_MAX_RETRIES=2
QWEATHER_MIN_INTERVAL_SECONDS=0.1
QWEATHER_REFERENCE_POINT_ID=XH_ENT_0009

# WeatherCN 普通 Key 独立探针，默认关闭
WEATHERCN_STANDARD_ENABLED=false
WEATHERCN_STANDARD_API_KEY=
WEATHERCN_STANDARD_BASE_URL=https://openapi.weathercn.com

# 本地历史数据保留开关与周期
WEATHER_HISTORY_ENABLED=true
WEATHER_HISTORY_RETENTION_DAYS=365

# Google Pollen 独立开关、密钥、单轮硬预算和节流
POLLEN_ENABLED=false
POLLEN_API_KEY=
POLLEN_MAX_CALLS_PER_RUN=60
POLLEN_MIN_INTERVAL_SECONDS=1.0

# 上海公共数据噪声接口，真实 token 仅写入本地 .env
SHANGHAI_NOISE_ENABLED=false
SHANGHAI_NOISE_TOKEN=
SHANGHAI_NOISE_API_URL=https://data.sh.gov.cn/interface/O5485687412025006/59015
SHANGHAI_NOISE_PAGE_SIZE=100
SHANGHAI_NOISE_MAX_CALLS_PER_RUN=4
SHANGHAI_NOISE_CONNECT_TIMEOUT_SECONDS=5
SHANGHAI_NOISE_READ_TIMEOUT_SECONDS=30
SHANGHAI_NOISE_MIN_INTERVAL_SECONDS=0.2
SHANGHAI_NOISE_MAX_AGE_HOURS=48
