{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-repair.schema.json",
  "title": "Generation Repair Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "files"],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "generation-file.schema.json"}
    }
  }
}
